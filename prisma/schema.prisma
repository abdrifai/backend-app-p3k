  @@index([arsipSkCpnsId], map: "data_p3k_arsipSkCpnsId_fkey")
  @@index([editedById], map: "data_p3k_editedById_fkey")
  @@index([unorIndukId], map: "data_p3k_unorIndukId_fkey")
  @@map("data_p3k")
}

model ArsipKontrak {
  id             String           @id @default(uuid())
  namaFile       String?
  fileUrl        String
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  riwayatKontrak RiwayatKontrak[]

  @@map("arsip_kontrak")
}

model RiwayatKontrak {
  id             String        @id @default(uuid())
  kontrakKe      Int
  tanggalMulai   String
  tanggalSelesai String
  keterangan     String?
  dataP3kId      String
  arsipKontrakId String?
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  gajiPokok      Decimal?
  golongan       String?
  mkBulan        Int?
  mkTahun        Int?
  nomorKontrak   String?
  arsipKontrak   ArsipKontrak? @relation(fields: [arsipKontrakId], references: [id])
  dataP3k        DataP3k       @relation(fields: [dataP3kId], references: [id])

  @@index([dataP3kId])
  @@index([arsipKontrakId], map: "riwayat_kontrak_arsipKontrakId_fkey")
  @@map("riwayat_kontrak")
}

model TemplateKontrak {
  id                 String               @id @default(uuid())
  nama               String
  deskripsi          String?
  fileUrl            String
  namaFile           String?
  isActive           Boolean              @default(true)
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  usulanPerpanjangan UsulanPerpanjangan[]

  @@map("template_kontrak")
}

model UsulanPerpanjangan {
  id                String           @id @default(uuid())
  tanggalMulai      String
  tanggalSelesai    String
  keterangan        String?
  status            String           @default("PENDING")
  alasanPenolakan   String?
  generatedFileUrl  String?
  dataP3kId         String
  templateKontrakId String?
  isDeleted         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  nomorKontrak      String?
  editedById        String?
  tanggalTtd        String?
  finalFileUrl      String?
  kontrakKe         Int?
  dataP3k           DataP3k          @relation(fields: [dataP3kId], references: [id])
  editedBy          User?            @relation("UsulanEditor", fields: [editedById], references: [id])
  templateKontrak   TemplateKontrak? @relation(fields: [templateKontrakId], references: [id])

  @@index([dataP3kId])
  @@index([status])
  @@index([editedById], map: "usulan_perpanjangan_editedById_fkey")
  @@index([templateKontrakId], map: "usulan_perpanjangan_templateKontrakId_fkey")
  @@map("usulan_perpanjangan")
}

model TabelGaji {
  id         String   @id @default(uuid())
  golongan   String
  mkTahun    Int
  gaji       Int
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  aturanGaji String?

  @@unique([golongan, mkTahun])
  @@map("tabel_gaji")
}

model TaskUsulan {
  id               String    @id @default(uuid()) @db.VarChar(36)
  dataP3kId        String    @db.VarChar(36)
  assignedToUserId String    @db.VarChar(36)
  kegiatan         String    @default("Umum") @db.VarChar(150)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  assignedToUser   User      @relation("UsulanAssignmentUser", fields: [assignedToUserId], references: [id])
  dataP3k          DataP3k   @relation(fields: [dataP3kId], references: [id])

  @@index([assignedToUserId])
  @@index([dataP3kId])
  @@map("task_usulan_pk")
}

model TaskPeremajaan {
  id               String    @id @default(uuid()) @db.VarChar(36)
  dataP3kId        String    @db.VarChar(36)
  assignedToUserId String    @db.VarChar(36)
  kegiatan         String    @default("Umum") @db.VarChar(150)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  assignedToUser   User      @relation("PeremajaanAssignmentUser", fields: [assignedToUserId], references: [id])
  dataP3k          DataP3k   @relation(fields: [dataP3kId], references: [id])

  @@index([assignedToUserId])
  @@index([dataP3kId])
  @@map("task_peremajaan")
}

model TaskFieldConfig {
  id        String   @id @default(uuid()) @db.VarChar(36)
  fieldName String   @unique @db.VarChar(100)
  label     String   @db.VarChar(150)
  inputType String   @default("text") @db.VarChar(20)
  groupName String?  @db.VarChar(50)
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_field_configs")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  userId     String
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation("UserActivities", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@map("activity_logs")
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_configs")
}

model ActivityLogArchive {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  userId     String
  archivedAt DateTime @default(now())
  createdAt  DateTime
  updatedAt  DateTime
  user       User     @relation("UserArchiveActivities", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@map("activity_logs_archive")
}
model Kegiatan {
  id        String   @id @default(uuid()) @db.VarChar(36)
  nama      String   @db.VarChar(150) @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleMenuPermission {
  id          String   @id @default(uuid())
  role        String   @db.VarChar(50)
  menuKey     String   @db.VarChar(100)
  isAllowed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, menuKey])
  @@index([role])
  @@map("role_menu_permissions")
}

model RekapKinerjaHarian {
  id          String   @id @default(uuid())
  tanggal     DateTime @db.Date
  userId      String
  namaLengkap String
  username    String
  role        String   @default("")
  pending     Int      @default(0)
  approved    Int      @default(0)
  srikandi    Int      @default(0)
  selesai     Int      @default(0)
  rejected    Int      @default(0)
  total       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([tanggal, userId])
  @@index([tanggal])
  @@index([userId])
  @@map("rekap_kinerja_harian")
}
