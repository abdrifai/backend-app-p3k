  nipBaru               String               @unique
  pnsId                 String               @unique
  nama                  String
  gelarDepan            String?
  gelarBelakang         String?
  tempatLahirId         String?
  tempatLahirNama       String?
  tanggalLahir          String?
  jenisKelamin          String?
  agamaId               String?
  agamaNama             String?
  jenisKawinId          String?
  jenisKawinNama        String?
  nik                   String?
  nomorHp               String?
  email                 String?
  emailGov              String?
  alamat                String?
  npwpNomor             String?
  bpjs                  String?
  jenisPegawaiId        String?
  jenisPegawaiNama      String?
  kedudukanHukumId      String?
  kedudukanHukumNama    String?
  statusCpnsPns         String?
  kartuAsnVirtual       String?
  nomorSkCpns           String?
  tanggalSkCpns         String?
  tmtCpns               String?
  nomorSkPns            String?
  tanggalSkPns          String?
  tmtPns                String?
  golAwalId             String?
  golAwalNama           String?
  golAkhirId            String?
  golAkhirNama          String?
  tmtGolongan           String?
  mkTahun               String?
  mkBulan               String?
  jenisJabatanId        String?
  jenisJabatanNama      String?
  jabatanId             String?
  jabatanNama           String?
  tmtJabatan            String?
  tingkatPendidikanId   String?
  tingkatPendidikanNama String?
  pendidikanId          String?
  pendidikanNama        String?
  tahunLulus            String?
  kpknId                String?
  kpknNama              String?
  lokasiKerjaId         String?
  lokasiKerjaNama       String?
  unorId                String?
  unorNama              String?
  instansiIndukId       String?
  instansiIndukNama     String?
  instansiKerjaId       String?
  instansiKerjaNama     String?
  satuanKerjaIndukId    String?
  satuanKerjaIndukNama  String?
  satuanKerjaKerjaId    String?
  satuanKerjaKerjaNama  String?
  isValidNik            String?
  namaSekolah           String?
  flagIkd               String?
  statusPensiun         String?              @default("AKTIF")
  jenisPensiunId        String?
  arsipSkPensiunId      String?
  arsipSkCpnsId         String?
  isDeleted             Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  unorIndukId           String?
  editedById            String?
  jenisPensiun          RefJenisPensiun?     @relation(fields: [jenisPensiunId], references: [id])
  arsipSkPensiun        ArsipSkPensiun?      @relation(fields: [arsipSkPensiunId], references: [id])
  arsipSkCpns           ArsipSkCpns?         @relation(fields: [arsipSkCpnsId], references: [id])
