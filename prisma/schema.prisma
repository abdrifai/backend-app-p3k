generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  email               String               @unique
  password            String
  isDeleted           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  namaLengkap         String               @default("")
  role                String               @default("user")
  foto                String?
  lastActiveAt        DateTime?
  lastLoginAt         DateTime?
  lastIpAddress       String?
  lastUserAgent       String?              @db.VarChar(500)
  dataP3kId           String?              @unique
  dataP3kParuhWaktuId String?              @unique
  jenisPegawaiPortal  String?
  mustChangePassword  Boolean              @default(false)
  dataP3k             DataP3k?             @relation("AkunPegawaiPenuh", fields: [dataP3kId], references: [id], onDelete: Restrict)
  dataP3kParuhWaktu   DataP3kParuhWaktu?   @relation("AkunPegawaiParuh", fields: [dataP3kParuhWaktuId], references: [id], onDelete: Restrict)
  activityLogs        ActivityLog[]        @relation("UserActivities")
  activityLogsArchive ActivityLogArchive[] @relation("UserArchiveActivities")
  editedTasks         DataP3k[]            @relation("TaskEditor")
  tasks               TaskPeremajaan[]     @relation("PeremajaanAssignmentUser")
  usulanTasks         TaskUsulan[]         @relation("UsulanAssignmentUser")
  usulanEditedTasks   UsulanPerpanjangan[] @relation("UsulanEditor")
  srikandiHistories   SrikandiHistory[]    @relation("SrikandiHistoryCreator")
  rekapKinerja        RekapKinerjaHarian[]
  masalahPegawaiCreated MasalahPegawai[]   @relation("MasalahPegawaiCreator")
  riwayatPenangananCreated RiwayatPenangananMasalah[] @relation("RiwayatPenangananUser")
  usulanDiverifikasi   UsulanPerbaikanData[] @relation("PerbaikanVerifikator")
  statusPerbaikanUpdated RiwayatStatusPerbaikan[] @relation("StatusPerbaikanUser")
  pejabatPenandatangan PejabatPenandatangan?
  logTandaTangan       LogTandaTangan[]      @relation("LogTtdUser")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model AktivasiPegawaiToken {
  id            String    @id @default(uuid())
  nipBaru       String
  jenisPegawai  String
  dataPegawaiId String
  email         String
  otpHash       String
  attempts      Int       @default(0)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([nipBaru])
  @@map("aktivasi_pegawai_tokens")
}

