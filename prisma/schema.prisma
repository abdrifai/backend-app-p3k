model ArsipSkPensiun {
  id                String              @id @default(uuid())
  nomorSk           String              @unique
  tanggalSk         String?
  fileUrl           String?
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  dataP3k           DataP3k[]
  dataP3kParuhWaktu DataP3kParuhWaktu[]

  @@map("arsip_sk_pensiun")
}

model ArsipSkCpns {
  id                String              @id @default(uuid())
  nomorSk           String              @unique
  tanggalSk         String?
  fileUrl           String?
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  dataP3k           DataP3k[]
  dataP3kParuhWaktu DataP3kParuhWaktu[]

  @@map("arsip_sk_cpns")
}

model RefUnor {
  id                String              @id @default(uuid())
  nama              String
  kode              String?
  parentId          String?             @map("parent_id")
  parent            RefUnor?            @relation("UnorHierarchy", fields: [parentId], references: [id], onDelete: Restrict, map: "ref_unor_parent_id_fkey")
  children          RefUnor[]           @relation("UnorHierarchy")
  level             Int                 @default(1)
  jenis             String?             @default("INDUK")
  keterangan        String?
  isActive          Boolean             @default(true) @map("is_active")
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  dataP3ks          DataP3k[]
  mappingUnors      MappingUnor[]
  dataP3kParuhWaktu DataP3kParuhWaktu[]

  @@index([parentId])
  @@index([nama])
  @@map("ref_unor")
}

model MappingUnor {
  id          String    @id @default(uuid())
  nipBaru     String    @unique
  dataP3kId   String?   @unique
  unorAsal    String?
  refUnorId   String
  refUnorNama String?
  keterangan  String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dataP3k     DataP3k?  @relation(fields: [dataP3kId], references: [id], onDelete: Cascade)
  refUnor     RefUnor   @relation(fields: [refUnorId], references: [id], onDelete: Restrict)

  @@index([refUnorId], map: "mapping_unor_refUnorId_idx")
  @@index([unorAsal], map: "mapping_unor_unorAsal_idx")
  @@map("mapping_unor")
}

