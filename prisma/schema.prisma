model RefJenisPensiun {
  id                String              @id @default(uuid())
  kode              String?             @unique
  nama              String
  keterangan        String?             @db.Text
  isActive          Boolean             @default(true) @map("is_active")
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  dataP3k           DataP3k[]
  dataP3kParuhWaktu DataP3kParuhWaktu[]

  @@map("ref_jenis_pensiun")
}

model ArsipKontrak {
  id             String           @id @default(uuid())
  namaFile       String?
  fileUrl        String
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  riwayatKontrak RiwayatKontrak[]

  @@map("arsip_kontrak")
}

model RiwayatKontrak {
  id                  String             @id @default(uuid())
  kontrakKe           Int
  tanggalMulai        String
  tanggalSelesai      String
  keterangan          String?
  dataP3kId           String?
  dataP3kParuhWaktuId String?
  arsipKontrakId      String?
  isDeleted           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  gajiPokok           Decimal?
  golongan            String?
  mkBulan             Int?
  mkTahun             Int?
  nomorKontrak        String?
  arsipKontrak        ArsipKontrak?      @relation(fields: [arsipKontrakId], references: [id])
  dataP3k             DataP3k?           @relation(fields: [dataP3kId], references: [id])
  dataP3kParuhWaktu   DataP3kParuhWaktu? @relation(fields: [dataP3kParuhWaktuId], references: [id])

  @@index([dataP3kId])
  @@index([dataP3kParuhWaktuId])
  @@index([arsipKontrakId], map: "riwayat_kontrak_arsipKontrakId_fkey")
  @@map("riwayat_kontrak")
}

model TemplateKontrak {
  id                 String               @id @default(uuid())
  nama               String
  deskripsi          String?
  fileUrl            String
  namaFile           String?
  isActive           Boolean              @default(true)
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  usulanPerpanjangan UsulanPerpanjangan[]

  @@map("template_kontrak")
}

model UsulanPerpanjangan {
  id                String           @id @default(uuid())
  tanggalMulai      String
  tanggalSelesai    String
  keterangan        String?
  status            String           @default("PENDING")
  alasanPenolakan   String?
  generatedFileUrl  String?
  dataP3kId         String
  templateKontrakId String?
  isDeleted         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  nomorKontrak      String?
  editedById        String?
  tanggalTtd        String?
  finalFileUrl      String?
  kontrakKe         Int?
  statusSrikandi    String?
  statusTte         String?
  pdfDraftUrl       String?
  pdfSignedUrl      String?
  catatanTte        String?          @db.Text
  dataP3k           DataP3k            @relation(fields: [dataP3kId], references: [id])
  editedBy          User?              @relation("UsulanEditor", fields: [editedById], references: [id])
  templateKontrak   TemplateKontrak?   @relation(fields: [templateKontrakId], references: [id])
  srikandiHistories SrikandiHistory[]
  logTandaTangan    LogTandaTangan[]

  @@index([dataP3kId])
  @@index([status])
  @@index([statusSrikandi])
  @@index([statusTte])
  @@index([editedById], map: "usulan_perpanjangan_editedById_fkey")
  @@index([templateKontrakId], map: "usulan_perpanjangan_templateKontrakId_fkey")
  @@map("usulan_perpanjangan")
}

model SrikandiHistory {
  id          String             @id @default(uuid())
  usulanId    String
  status      String
  keterangan  String?            @db.Text
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  usulan      UsulanPerpanjangan @relation(fields: [usulanId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("SrikandiHistoryCreator", fields: [createdById], references: [id])

  @@index([usulanId])
  @@index([createdById])
  @@map("srikandi_history")
}

model TabelGaji {
  id         String   @id @default(uuid())
  golongan   String
  mkTahun    Int
  gaji       Int
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  aturanGaji String?

  @@unique([golongan, mkTahun])
  @@map("tabel_gaji")
}

model TaskUsulan {
  id               String    @id @default(uuid()) @db.VarChar(36)
  dataP3kId        String    @db.VarChar(36)
  assignedToUserId String    @db.VarChar(36)
  kegiatan         String    @default("Umum") @db.VarChar(150)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  assignedToUser   User      @relation("UsulanAssignmentUser", fields: [assignedToUserId], references: [id])
  dataP3k          DataP3k   @relation(fields: [dataP3kId], references: [id])

  @@index([assignedToUserId])
  @@index([dataP3kId])
  @@map("task_usulan_pk")
}

model TaskPeremajaan {
  id               String    @id @default(uuid()) @db.VarChar(36)
  dataP3kId        String    @db.VarChar(36)
  assignedToUserId String    @db.VarChar(36)
  kegiatan         String    @default("Umum") @db.VarChar(150)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
  assignedToUser   User      @relation("PeremajaanAssignmentUser", fields: [assignedToUserId], references: [id])
  dataP3k          DataP3k   @relation(fields: [dataP3kId], references: [id])

  @@index([assignedToUserId])
  @@index([dataP3kId])
  @@map("task_peremajaan")
}

model TaskFieldConfig {
  id        String   @id @default(uuid()) @db.VarChar(36)
  fieldName String   @unique @db.VarChar(100)
  label     String   @db.VarChar(150)
  inputType String   @default("text") @db.VarChar(20)
  groupName String?  @db.VarChar(50)
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_field_configs")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  userId     String
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation("UserActivities", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@map("activity_logs")
}

model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_configs")
}

model ActivityLogArchive {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  userId     String
  archivedAt DateTime @default(now())
  createdAt  DateTime
  updatedAt  DateTime
  user       User     @relation("UserArchiveActivities", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@map("activity_logs_archive")
}
model Kegiatan {
  id        String   @id @default(uuid()) @db.VarChar(36)
  nama      String   @db.VarChar(150) @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleMenuPermission {
  id          String   @id @default(uuid())
  role        String   @db.VarChar(50)
  menuKey     String   @db.VarChar(100)
  isAllowed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, menuKey])
  @@index([role])
  @@map("role_menu_permissions")
}

model RekapKinerjaHarian {
  id          String   @id @default(uuid())
  tanggal     DateTime @db.Date
  userId      String
  namaLengkap String
  username    String
  role        String   @default("")
  pending     Int      @default(0)
  approved    Int      @default(0)
  srikandi    Int      @default(0)
  selesai     Int      @default(0)
  rejected    Int      @default(0)
  total       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([tanggal, userId])
  @@index([tanggal])
  @@index([userId])
  @@map("rekap_kinerja_harian")
}

model KategoriMasalah {
  id              String            @id @default(uuid())
  kode            String            @unique
  nama            String
  deskripsi       String?           @db.Text
  warnaBadge      String?           @default("#ef4444")
  isActive        Boolean           @default(true) @map("is_active")
  isDeleted       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  masalahPegawai  MasalahPegawai[]

  @@map("kategori_masalah")
}

model MasalahPegawai {
  id                  String                 @id @default(uuid())
  nomorKasus          String                 @unique
  judul               String
  tanggalKejadian     DateTime?              @db.Date
  tingkatKeparahan    String                 @default("SEDANG")
  status              String                 @default("OPEN")
  deskripsi           String                 @db.LongText
  ringkasanMasalah    String?                @db.VarChar(500)
  tindakLanjut        String?                @db.Text
  catatanPenyelesaian String?                @db.Text
  tanggalSelesai      DateTime?

  dataP3kId           String
  dataP3k             DataP3k                @relation(fields: [dataP3kId], references: [id], onDelete: Restrict)

  kategoriId          String
  kategori            KategoriMasalah        @relation(fields: [kategoriId], references: [id], onDelete: Restrict)

  createdById         String
  createdBy           User                   @relation("MasalahPegawaiCreator", fields: [createdById], references: [id])

  lampiran            LampiranMasalah[]
  riwayatPenanganan   RiwayatPenangananMasalah[]

  isDeleted           Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([dataP3kId])
  @@index([kategoriId])
  @@index([createdById])
  @@index([status])
  @@index([tingkatKeparahan])
  @@map("masalah_pegawai")
}

model LampiranMasalah {
  id               String          @id @default(uuid())
  masalahPegawaiId String
  namaFile         String
  fileUrl          String
  fileType         String?
  fileSize         Int?
  keterangan       String?
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  masalahPegawai   MasalahPegawai  @relation(fields: [masalahPegawaiId], references: [id], onDelete: Cascade)

  @@index([masalahPegawaiId])
  @@map("lampiran_masalah")
}

model RiwayatPenangananMasalah {
  id               String          @id @default(uuid())
  masalahPegawaiId String
  statusSebelumnya String?
  statusBaru       String
  tindakan         String
  keterangan       String?         @db.Text
  userId           String
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  masalahPegawai   MasalahPegawai  @relation(fields: [masalahPegawaiId], references: [id], onDelete: Cascade)
  user             User            @relation("RiwayatPenangananUser", fields: [userId], references: [id])

  @@index([masalahPegawaiId])
  @@index([userId])
  @@map("riwayat_penanganan_masalah")
}

model RiwayatKeluarga {
  id                   String             @id @default(uuid())
  dataP3kId            String?
  dataP3kParuhWaktuId  String?
  hubungan             String
  nama                 String
  nik                  String?
  tempatLahir          String?
  tanggalLahir         String?
  jenisKelamin         String?
  pekerjaan            String?
  statusHidup          Boolean            @default(true)
  tanggalMenikah       String?
  nomorAktaNikah       String?
  nomorAktaLahir       String?
  isTanggungan         Boolean            @default(false)
  isDeleted            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  dataP3k              DataP3k?           @relation(fields: [dataP3kId], references: [id], onDelete: Restrict)
  dataP3kParuhWaktu    DataP3kParuhWaktu? @relation(fields: [dataP3kParuhWaktuId], references: [id], onDelete: Restrict)

  @@index([dataP3kId])
  @@index([dataP3kParuhWaktuId])
  @@index([hubungan])
  @@map("riwayat_keluarga")
}

model UsulanPerbaikanData {
  id                   String             @id @default(uuid())
  nomorUsulan          String             @unique
  dataP3kId            String?
  dataP3kParuhWaktuId  String?
  kategori             String
  aksi                 String
  targetId             String?
  dataLama             Json?
  dataBaru             Json
  alasan               String             @db.Text
  status               String             @default("DIAJUKAN")
  catatanVerifikator   String?            @db.Text
  verifikatorId        String?
  tanggalVerifikasi    DateTime?
  isDeleted            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  dataP3k              DataP3k?           @relation(fields: [dataP3kId], references: [id], onDelete: Restrict)
  dataP3kParuhWaktu    DataP3kParuhWaktu? @relation(fields: [dataP3kParuhWaktuId], references: [id], onDelete: Restrict)
  verifikator          User?              @relation("PerbaikanVerifikator", fields: [verifikatorId], references: [id], onDelete: SetNull)

  lampiran             LampiranPerbaikan[]
  riwayatStatus        RiwayatStatusPerbaikan[]

  @@index([dataP3kId])
  @@index([dataP3kParuhWaktuId])
  @@index([status])
  @@index([kategori])
  @@index([verifikatorId])
  @@map("usulan_perbaikan_data")
}

model LampiranPerbaikan {
  id               String               @id @default(uuid())
  usulanId         String
  namaFile         String
  fileUrl          String
  fileType         String?
  fileSize         Int?
  isDeleted        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  usulan           UsulanPerbaikanData  @relation(fields: [usulanId], references: [id], onDelete: Cascade)

  @@index([usulanId])
  @@map("lampiran_perbaikan")
}

model RiwayatStatusPerbaikan {
  id               String               @id @default(uuid())
  usulanId         String
  statusLama       String?
  statusBaru       String
  catatan          String?              @db.Text
  userId           String?
  createdAt        DateTime             @default(now())

  usulan           UsulanPerbaikanData  @relation(fields: [usulanId], references: [id], onDelete: Cascade)
  user             User?                @relation("StatusPerbaikanUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([usulanId])
  @@index([userId])
  @@map("riwayat_status_perbaikan")
}

model PejabatPenandatangan {
  id        String   @id @default(uuid())
  userId    String   @unique
  jabatan   String   // KEPALA_BKPSDM | SEKDA | BUPATI
  nama      String
  nip       String?
  nik       String
  jenis     String   // PARAF | TTE
  urutan    Int
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([jabatan])
  @@index([urutan])
  @@map("pejabat_penandatangan")
}

model LogTandaTangan {
  id              String             @id @default(uuid())
  usulanId        String
  tahap           String             // TTE_PEGAWAI | PARAF_KABAN | PARAF_SEKDA | TTE_BUPATI
  jenis           String             // PARAF | TTE
  userId          String?
  nik             String
  status          String             // SUKSES | GAGAL | DITOLAK
  pesan           String?            @db.Text
  idDokumenBsre   String?
  ipAddress       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  usulan          UsulanPerpanjangan @relation(fields: [usulanId], references: [id], onDelete: Cascade)
  user            User?              @relation("LogTtdUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([usulanId])
  @@index([userId])
  @@index([tahap])
  @@map("log_tanda_tangan")
}


