generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  email               String               @unique
  password            String
  isDeleted           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  namaLengkap         String               @default("")
  role                String               @default("user")
  foto                String?
  lastActiveAt        DateTime?
  lastLoginAt         DateTime?
  lastIpAddress       String?
  lastUserAgent       String?              @db.VarChar(500)
  activityLogs        ActivityLog[]        @relation("UserActivities")
  activityLogsArchive ActivityLogArchive[] @relation("UserArchiveActivities")
  editedTasks         DataP3k[]            @relation("TaskEditor")
  tasks               TaskPeremajaan[]     @relation("PeremajaanAssignmentUser")
  usulanTasks         TaskUsulan[]         @relation("UsulanAssignmentUser")
  usulanEditedTasks   UsulanPerpanjangan[] @relation("UsulanEditor")
  rekapKinerja        RekapKinerjaHarian[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

