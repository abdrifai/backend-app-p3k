  tanggalSkPns          String?
  tmtPns                String?
  golAwalId             String?
  golAwalNama           String?
  golAkhirId            String?
  golAkhirNama          String?
  tmtGolongan           String?
  mkTahun               String?
  mkBulan               String?
  jenisJabatanId        String?
  jenisJabatanNama      String?
  jabatanId             String?
  jabatanNama           String?
  tmtJabatan            String?
  tingkatPendidikanId   String?
  tingkatPendidikanNama String?
  pendidikanId          String?
  pendidikanNama        String?
