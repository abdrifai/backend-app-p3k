  @@index([arsipSkPensiunId], map: "data_p3k_paruh_waktu_arsipSkPensiunId_fkey")
  @@index([arsipSkCpnsId], map: "data_p3k_paruh_waktu_arsipSkCpnsId_fkey")
  @@index([unorNama])
  @@index([golAkhirNama])
  @@index([nama])
  @@map("data_p3k_paruh_waktu")
