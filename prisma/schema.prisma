  gelarDepan            String?
  gelarBelakang         String?
  tempatLahirId         String?
  tempatLahirNama       String?
  tanggalLahir          String?
  jenisKelamin          String?
  agamaId               String?
  agamaNama             String?
  jenisKawinId          String?
  jenisKawinNama        String?
  nik                   String?
  nomorHp               String?
  email                 String?
  emailGov              String?
  alamat                String?     @db.Text
  npwpNomor             String?
  bpjs                  String?
  jenisPegawaiId        String?
  jenisPegawaiNama      String?
  kedudukanHukumId      String?
  kedudukanHukumNama    String?
